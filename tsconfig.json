{
	// SvelteKit writes this base config (paths, generated types, required compiler options)
	// during sync. It sets no include/exclude, so the lists below replace them.
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"declaration": true,
		"declarationMap": true,
		"moduleResolution": "bundler"
	},
	// Path aliases are handled by the `alias` option of `sveltekit()` in vite.config.ts.
	"include": ["src/**/*.js", "src/**/*.ts", "src/**/*.svelte", "vite.config.ts"],
	"exclude": [
		"node_modules/**",
		"src/service-worker.js",
		"src/service-worker/**/*.js",
		"src/service-worker.ts",
		"src/service-worker/**/*.ts",
		"src/service-worker.d.ts",
		"src/service-worker/**/*.d.ts",
		"src/lib/convex/**",
		"src/lib/convex/**/*.ts",
		"src/lib/convex/**/*.js"
	]
}
